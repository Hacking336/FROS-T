{
  // Local-only Worker preview, mirroring the deployed manifest.
  // Run with: npx wrangler dev --config deploy/wrangler.dev.jsonc
  "name": "fros-t-local",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
